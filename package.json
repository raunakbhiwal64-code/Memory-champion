{
  "name": "mnemosyne",
  "version": "2.0.0",
  "description": "Mnemosyne: a memory-sport training app with a walkable 3D castle memory palace.",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "for f in tests/*.js; do echo \"=== $f ===\"; node \"$f\" || exit 1; done",
    "test:browser": "vite build && node tests/browser/castle.browser.js",
    "assets": "node scripts/fetch-assets.mjs"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "jsdom": "^24.1.3",
    "meshoptimizer": "^1.3.0",
    "playwright": "^1.63.0",
    "sharp": "^0.35.5",
    "vite": "^8.3.2"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
