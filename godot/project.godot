; Engine configuration file.
; Mnemosyne: memory palace training. Open this folder in Godot 4.7+.

config_version=5

[application]

config/name="Mnemosyne"
config/description="Memory palace training: a walkable 3D castle, a curriculum, drills and spaced review."
config/version="3.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/icon.svg"
boot_splash/bg_color=Color(0.0784, 0.0863, 0.1098, 1)
boot_splash/show_image=false

[autoload]

Content="*res://scripts/core/content.gd"
DB="*res://scripts/core/db.gd"
App="*res://scripts/ui/app.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="disabled"
window/handheld/orientation=6
window/energy_saving/keep_screen_on=false

[gui]

common/snap_controls_to_pixels=true
timers/tooltip_delay_sec=0.4

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.0784, 0.0863, 0.1098, 1)

[debug]

gdscript/warnings/inference_on_variant=1
